{
  "name": "jigsaw",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "start": "vite build && vite preview --host",
    "typecheck": "tsc -b",
    "cli": "esbuild cli/src/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=cli/dist/jigsaw.js \"--banner:js=#!/usr/bin/env node\""
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "nodemailer": "^10.0.12",
    "qrcode-generator": "^1.5.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@webgpu/types": "^0.1.74",
    "esbuild": "^0.28.2",
    "jpeg-js": "^0.4.4",
    "typescript": "^7.0.2",
    "vite": "^7.0.0"
  }
}
